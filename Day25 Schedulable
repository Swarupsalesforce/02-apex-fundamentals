Schedule it from Anonymous Apex, check Setup → Scheduled Jobs
One test — System.schedule inside startTest/stopTest, then assert a CronTrigger record exists

CLASS
public class NightlyTierJob implements Schedulable {
    public void execute(SchedulableContext sc) {
        Database.executeBatch(new TierRecalculationBatch(), 200);
    }
}

TEST CLASS

@isTest
public class jobSchedulesSuccessfully {
@isTest
static void jobSchedulesSuccessfully() {
    Test.startTest();
    String jobId = System.schedule('Test Tier Job', '0 0 2 * * ?', new NightlyTierJob());
    Test.stopTest();

    CronTrigger ct = [SELECT CronExpression, TimesTriggered FROM CronTrigger WHERE Id = :jobId];
    Assert.areEqual('0 0 2 * * ?', ct.CronExpression, 'Cron expression should match');
    Assert.areEqual(0, ct.TimesTriggered, 'Job should not have run yet');
}
}

