AND CHNAGED THE ACCOUNTTRIGGERHANDLER accountTier Method and added new getStrategyFor method

public class AccountTriggerHandler {
    public static void run(){
        if(Trigger.isBefore && Trigger.isInsert){
            validateRevenue(Trigger.new);
            assignTiers(Trigger.new);
        }
        if(Trigger.isBefore && Trigger.isUpdate){
            validateRevenue(Trigger.new);
            assignTiers(Trigger.new);
        }
        
    }
    public static void validateRevenue(List<Account> accounts){
        
        for(Account acc:accounts){
            if(acc.AnnualRevenue!=null && acc.AnnualRevenue<0){
                acc.AnnualRevenue.addError('Annual revenue cannot be negative.');
            }
        }
        
    }
    public static TierStrategy getStrategyFor(String accountType){
        if (accountType == 'Partner') {
            return new ContactCountTierStrategy();
        }
        return new RevenueTierStrategy();
    }
    public static void assignTiers(List<Account> accounts){
        for(Account acc: accounts){
            TierStrategy strategy = getStrategyFor(acc.Type);
            acc.Customer_Tier__c= strategy.calculateTier(acc);
        }
        
    }
    
}