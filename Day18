public class RevenueTierStrategy implements TierStrategy {
    public static String calculateTier(Account acc){
        if(acc.AnnualRevenue==null || acc.AnnualRevenue<=0) return null;
        if(acc.AnnualRevenue>=10000000) return 'Platinum';
        if(acc.AnnualRevenue>=5000000) return 'Gold';
        if(acc.AnnualRevenue>=1000000) return 'Silver';
        return 'Bronze';
    }
}

