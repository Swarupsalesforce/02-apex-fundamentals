Q- WordFrequencyCounter, the retention test. Restated:

Input: 'the quick fox jumps over the lazy dog the fox'
Output: each word with its count, then Most frequent: the (3)

ANS
String sentence= 'the quick fox jumps over the lazy dog the fox';
List<String> words= sentence.split(' ');
Integer bestCount=0;
String  frequentWord;
Map<String,Integer> countWord= new Map<String,Integer>();
for(String word: words){
    if(countWord.containsKey(word)){
        countWord.put(word,countWord.get(word)+1);
    }else{
        countWord.put(word,1);
    }
}
for(String word:countWord.keySet()){
    
    if(countWord.get(word)>bestCount){//In case of Tie as the value is greater than 0 then the first assignment will win
        bestCount=countWord.get(word);
        frequentWord= word;
        
    }
    System.debug(word+':'+countWord.get(word));
}
System.debug('Most Frequent : '+frequentWord+' '+bestCount);

Q-Input: List<String> names = {'Asha', 'Ravi', 'Amit', 'Meena', 'Raj'}
Output:

A → (Asha, Amit)
R → (Ravi, Raj)
M → (Meena)

ANS
List<String> names =new List<String>{'Asha', 'Ravi', 'Amit', 'Meena', 'Raj'};
Map<String,List<String>> namesByAlphabet= new Map<String,List<String>>();
for(String name: names){
    String alphabet=name.substring(0,1);
    if(!namesByAlphabet.containsKey(alphabet)){
        namesByAlphabet.put(alphabet,new List<String>());
    }
        namesByAlphabet.get(alphabet).add(name);
    
}System.debug(namesByAlphabet);

Q-Input: List<Integer> nums = {3, 8, 2, 7, 5, 10}
Output: even → (8, 2, 10) and odd → (3, 7, 5)

ANS
List<Integer> nums = new List<Integer>{3, 8, 2, 7, 5, 10};
Map<String,List<Integer>> evenAndOdd= new Map<String,List<Integer>>();
evenAndOdd.put('Even', new List<Integer>());
evenAndOdd.put('Odd', new List<Integer>());
for(Integer num: nums){
    if(Math.mod(num,2)==0){
        evenAndOdd.get('Even').add(num);
    }else{
        evenAndOdd.get('Odd').add(num);
    }
}System.debug(evenAndOdd);

Q-Two parallel Lists (same positions pair up):
products: {'LicenseA', 'LicenseB', 'LicenseA', 'Support', 'LicenseA'}
prices: {100, 250, 100, 75, 150}
Output: LicenseA : 350, LicenseB : 250, Support : 75

ANS
List<String> products= new List<String>{'LicenseA', 'LicenseB', 'LicenseA', 'Support', 'LicenseA'};
List<Decimal> prices= new List<Decimal> {100, 250, 100, 75, 150};
Map<String,Decimal> productPrice = new Map<String,Decimal>();
if(products.size()==prices.size()){
    
    for(Integer i=0; i<products.size(); i++){
        if (productPrice.containsKey(products[i])) {
    // Veteran: add current price to existing total
    Decimal currentTotal = productPrice.get(products[i]);
    productPrice.put(products[i], currentTotal + prices[i]);
} else {
    // Newcomer: initialize with the current price
    productPrice.put(products[i], prices[i]);
}
        
    }System.debug(productPrice);
}

