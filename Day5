Q- Input: {'rahul@gmail.com', 'priya@yahoo.com', 'amit@GMAIL.com', 'x@yahoo.com', 'broken-email', 'z@gmail.com'}
Output: gmail.com : 3 and yahoo.com : 2 (a count per domain)
ANS
List<String> emails= new List<String>{'rahul@gmail.com', 'priya@yahoo.com', 'amit@GMAIL.com', 'x@yahoo.com', 'broken-email', 'z@gmail.com'};
Map<String, Integer> domainCount = new Map<String, Integer>();   
    for(String email:emails){
        String domain= email.toLowerCase();
        domain= domain.substringAfter('@');
        if(String.isBlank(domain)){//This Will Skip Invalid Email
        continue;
        }
        if(domainCount.containsKey(domain)){
            domainCount.put(domain, domainCount.get(domain)+1);
        }
        else{
            domainCount.put(domain,1);
        }
        
    }

for(String domain: domainCount.keySet()){
    System.debug(domain+':'+domainCount.get(domain));
}

