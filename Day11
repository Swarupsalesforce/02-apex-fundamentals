@isTest

public class ContactTriggerHandlerTest {

    @isTest

    static void rollUpOnInsert(){

        Account acc= TestDataFactory.createAccount('RollUp Account', 500000);
        insert acc;
        List<Contact> cons=TestDataFactory.createContacts(3,acc.Id);

        Test.startTest();
        insert cons;
		Test.stopTest();

        Account result= [SELECT Count_Contacts__c  FROM Account WHERE Id =:acc.Id];
		Assert.areEqual(3,result.Count_Contacts__c,'The Count of Contacts should be 3');        

    }
     @isTest
    static void rollUpOnDelete(){

        Account acc= TestDataFactory.createAccount('RollUp Account', 500000);
        insert acc;
        List<Contact> con=TestDataFactory.createContacts(1,acc.Id);
        insert con;
        
        Account afterInsert= [SELECT Count_Contacts__c  FROM Account WHERE Id =:acc.Id];
		Assert.areEqual(1,afterInsert.Count_Contacts__c,'The Count of Contacts should be 1');
        
        Test.startTest();
        delete con;
		Test.stopTest();
        

        Account afterDelete= [SELECT Count_Contacts__c  FROM Account WHERE Id =:acc.Id];
		Assert.areEqual(0,afterDelete.Count_Contacts__c,'The Count of Contacts should be 0');        

    }
    @isTest
    static void rollUpAfterReparenting(){

        List<Account> acc= TestDataFactory.createAccounts(2, 500000);
        insert acc;
        List<Contact> con=TestDataFactory.createContacts(1,acc[0].Id);
        insert con;
        
        Account afterInsert= [SELECT Count_Contacts__c  FROM Account WHERE Id =:acc[0].Id];
		Assert.areEqual(1,afterInsert.Count_Contacts__c,'The Count of Contacts should be 1');

        con[0].AccountId= acc[1].Id;
        Test.startTest();
        update con;
		Test.stopTest();

        Map<Id,Account> accounts= new Map<Id,Account>([SELECT Id,Count_Contacts__c FROM Account WHERE Id IN:acc]);
		Assert.areEqual(0,accounts.get(acc[0].Id).Count_Contacts__c,'The Count of Contacts should be 0');        
		Assert.areEqual(1,accounts.get(acc[1].Id).Count_Contacts__c,'The Count of Contacts should be 1');
    }
	@isTest
    static void rollUpBulkTest(){

        List<Account> accs= TestDataFactory.createAccounts(2, 10000);
        insert accs;
        List<Contact> cons = TestDataFactory.createContacts(100, accs[0].Id);
		cons.addAll(TestDataFactory.createContacts(100, accs[1].Id));
        
        Test.startTest();
        insert cons;
		Test.stopTest();

        Map<Id,Account> accounts= new Map<Id,Account>([SELECT Id,Count_Contacts__c FROM Account WHERE Id IN:accs]);
		Assert.areEqual(100,accounts.get(accs[0].Id).Count_Contacts__c,'The Count of Contacts should be 100');        
		Assert.areEqual(100,accounts.get(accs[1].Id).Count_Contacts__c,'The Count of Contacts should be 100');
    }
    @isTest

    static void rollUpWithoutAccount(){

        List<Contact> cons=TestDataFactory.createContacts(1,null);

        Test.startTest();
        insert cons;
		Test.stopTest();

        Assert.isNotNull(cons[0].Id, 'Contact with no Account should still save');

    }


}